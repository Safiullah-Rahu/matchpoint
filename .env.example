# Copy to .env (never commit it).
ANTHROPIC_API_KEY=
# Org-level keys may also need: ANTHROPIC_WORKSPACE_ID=
MATCHPOINT_HOME=./var
# Require "Authorization: Bearer <token>" on /api/* (health stays open)
MATCHPOINT_API_TOKEN=
# Ship spans to any OTLP backend (Jaeger, Honeycomb, Datadog, Grafana Tempo, ADOT -> X-Ray)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=matchpoint
